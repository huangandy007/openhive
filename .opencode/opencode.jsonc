{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  // 【这是要保留的定制】openhive / 006-ai-session T012（FR-009）：删除类动作强制人确认。
  // 闸门机制用的是上游工具层的 permission.ask（未改一行源码），这里只落**规则**：
  // 默认是 `"*": "allow"`，不写这一段的话 `rm -rf` 会一声不响地跑掉。
  // pattern 的写法与 shell 扫描出的 always 同形（`rm -rf build` → `rm *`）；
  // 清单、样本、已知天花板见 packages/opencode/test/permission/openhive-highrisk-ask.test.ts。
  "permission": {
    "bash": {
      "rm *": "ask",
      "rmdir *": "ask",
      "rd *": "ask",
      "del *": "ask",
      "erase *": "ask",
      "Remove-Item *": "ask",
      "shred *": "ask",
      "git clean *": "ask",
    },
  },
  // 【这是要保留的定制】openhive / 006-ai-session T011（FR-008）：把 openhive 的环境准则
  // 接进每次会话的系统提示词。规则正文见 .opencode/instructions/（同一份由部署侧下发到民警环境）。
  "instructions": [".opencode/instructions/*.md"],
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  "mcp": {},
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
