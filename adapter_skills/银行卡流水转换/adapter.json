{
  "id": "bank-card-statement",
  "name": "银行卡流水转换",
  "version": "1.0.1",
  "kind": "converter",
  "materialType": "资金",
  "attributeKeys": ["对方:开户行", "对方:证件号"],
  "match": {
    "requiredHeaders": ["查询账号", "交易对方账卡号", "借贷标志", "交易金额", "交易时间", "交易是否成功"],
    "optionalHeaders": [
      "交易对方名称",
      "交易余额",
      "交易类型",
      "交易对方账号开户行",
      "交易对方证件号码",
      "交易网点名称",
      "交易流水号",
      "凭证号",
      "终端号",
      "现金标志",
      "交易摘要",
      "商户名称",
      "IP地址",
      "IP归属地",
      "MAC地址",
      "交易网点代码",
      "日志号",
      "传票号",
      "交易柜员号",
      "商户号",
      "币种",
      "备注",
      "凭证种类",
      "交易区划代码",
      "交易网点电话",
      "交易发生地",
      "网银客户端端口",
      "手机IMEI号",
      "手机转账手机号",
      "资金流向",
      "收单机构名称",
      "收单机构金融机构编码",
      "二级商户名称",
      "二级商户号",
      "清算机构名称"
    ],
    "priority": 100
  },
  "status": {
    "success": ["成功", "交易成功"],
    "failure": ["失败", "交易失败"]
  },
  "nonTransactionFlags": ["O"],
  "bankNameDeny": ["alipay", "支付宝", "财付通", "tenpay", "微信支付", "微信", "银联", "网联"],
  "admission": {
    "checks": ["查询账号非空", "借贷标志合法", "金额可解析", "时间可解析", "交易状态可识别"],
    "thresholds": {
      "时间可解析": 0.99,
      "其余": 1.0
    }
  },
  "rowRules": [
    "查询账号 = 本方账号；交易对方账卡号 = 对方账号（平台统一 41 列格式）",
    "借贷决定方向：借=付、贷=收；仅当摘要/类型含「冲正」且相邻余额差精确等于金额时按余额翻向（实测 2 笔冲正标借实收）",
    "借贷标志 O 是非资金变动标记（广发信用卡年费减免等）：逐行跳过、不进方向闸分母；未声明的方向值仍整份拒收",
    "金额取绝对值、两位小数字符串，不用负号暗示方向",
    "交易时间按 Asia/Shanghai 解释，输出 Unix 秒",
    "对方户名取『交易对方名称』（『商户名称』是摘要/分期说明，不是户名，不写）",
    "开户行取『交易对方账号开户行』；纯数字代码与支付通道标记不写入",
    "证件号取『交易对方证件号码』，非空即写；不做证件类型校验",
    "缺对方账号（含全零占位 00000000）/ 金额为零 / 交易未成功 / 时间无法解析的行逐行跳过，金额进跳过汇总"
  ],
  "entry": {
    "command": "bun run convert.ts",
    "input": "xls/xlsx/csv",
    "output": "json"
  },
  "output": {
    "file": "result.json"
  }
}
